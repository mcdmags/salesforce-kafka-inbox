{
  "ConnectionStrings": {
    "inboxdb": "Host=localhost;Database=inboxdb;Username=postgres;Password=postgres",
    "kafka": ""
  },
  "Salesforce": {
    "InstanceUrl": "https://your-domain.my.salesforce.com",
    "ClientId": "",
    "ClientSecret": "",
    "RequestTimeout": "00:01:30"
  },
  "Sync": {
    "Workers": 4,
    "BatchSize": 75
  },
  "Kafka": {
    "Topics": {
      "account": "account-changes",
      "accountRelationship": "account-relationship-changes",
      "contact": "contact-changes"
    },
    "Partitions": 6
  },
  "Postgres": {
    "Retry": {
      "MaxRetryCount": 5,
      "BaseDelay": "00:00:00.100",
      "MaxRetryDelay": "00:00:05"
    }
  },
  "Aspire": {
    "Confluent": {
      "Kafka": {
        "Consumer": {
          "Config": {
            "GroupId": "salesforce-sync",
            "AutoOffsetReset": "Earliest"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  }
}