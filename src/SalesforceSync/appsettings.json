{
  "ConnectionStrings": {
    "inboxdb": "Host=localhost;Database=inboxdb;Username=postgres;Password=postgres",
    "kafka": ""
  },
  "Salesforce": {
    "InstanceUrl": "https://your-domain.my.salesforce.com",
    "TokenUrl": "https://your-domain.my.salesforce.com/services/oauth2/token",
    "ClientId": "",
    "ClientSecret": "",
    "UseFake": false
  },
  "FakeSalesforce": {
    "Latency": "00:00:00.050",
    "DailyApiLimit": 1000000,
    "EnforceDailyLimit": true,
    "EnforceVersionRule": true
  },
  "Sync": {
    "Workers": 4,
    "MaxConcurrentRequests": 6
  },
  "RateLimit": {
    "MaxWait": "00:00:20",
    "DailySoftRatio": 0.8,
    "DailySoftSpeed": 0.25,
    "DailyHardRatio": 0.95,
    "DailyHardPause": "00:15:00",
    "BurstSoftRatio": 0.8,
    "BurstSoftSpeed": 0.5,
    "BurstPause": "00:00:10",
    "ReportInterval": "00:00:05"
  },
  "Kafka": {
    "Topic": "account-changes",
    "Partitions": 6
  },
  "Aspire": {
    "Confluent": {
      "Kafka": {
        "Consumer": {
          "Config": {
            "GroupId": "salesforce-sync",
            "AutoOffsetReset": "Earliest",
            "EnableAutoCommit": false
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  }
}