{
  "ConnectionStrings": {
    "inboxdb": "Host=localhost;Database=inboxdb;Username=postgres;Password=postgres",
    "kafka": ""
  },
  "Salesforce": {
    "InstanceUrl": "https://your-domain.my.salesforce.com",
    "ClientId": "",
    "ClientSecret": ""
  },
  "Sync": {
    "Workers": 4,
    "MaxConcurrentRequests": 6,
    "BatchSize": 75
  },
  "SalesforceLimits": {
    "DailyApiAllocation": 115000,
    "ConcurrentLongRunningLimit": 25,
    "LongRunningThreshold": "00:00:20",
    "RequestTimeout": "00:01:30"
  },
  "RateLimit": {
    "MaxWait": "00:00:20",
    "MaxRequestsPerSecond": 2,
    "BurstCapacity": 5,
    "DailyBudgetShare": 0.5,
    "BudgetWindow": "1.00:00:00",
    "UsageBucket": "00:10:00",
    "ConcurrentLimitPause": "00:00:30",
    "DailySoftRatio": 0.8,
    "DailySoftSpeed": 0.25,
    "DailyHardRatio": 0.95,
    "DailyHardPause": "00:15:00",
    "ReportInterval": "00:00:05"
  },
  "Kafka": {
    "Topic": "account-changes",
    "Partitions": 6
  },
  "Postgres": {
    "Retry": {
      "MaxRetryCount": 5,
      "BaseDelay": "00:00:00.100",
      "MaxRetryDelay": "00:00:05"
    }
  },
  "Aspire": {
    "Confluent": {
      "Kafka": {
        "Consumer": {
          "Config": {
            "GroupId": "salesforce-sync",
            "AutoOffsetReset": "Earliest"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  }
}