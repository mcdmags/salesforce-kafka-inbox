{
  "ConnectionStrings": {
    "inboxdb": "Host=localhost;Database=inboxdb;Username=postgres;Password=postgres",
    "kafka": ""
  },
  "Salesforce": {
    "InstanceUrl": "https://your-domain.my.salesforce.com",
    "TokenUrl": "https://your-domain.my.salesforce.com/services/oauth2/token",
    "ClientId": "",
    "ClientSecret": "",
    "UseFake": false,
    "AllOrNone": false,
    "ParentLink": "ReferenceId"
  },
  "FakeSalesforce": {
    "Latency": "00:00:00.050",
    "DailyApiLimit": 1000000,
    "EnforceDailyLimit": true
  },
  "Sync": {
    "Workers": 4,
    "MaxConcurrentRequests": 6,
    "BatchSize": 75
  },
  "SalesforceLimits": {
    "OrgType": "Production",
    "Edition": "Enterprise",
    "Licenses": { "Salesforce": 15 },
    "CallsPerLicense": {},
    "PurchasedApiCalls": 0,
    "LongRunningThreshold": "00:00:20",
    "RequestTimeout": "00:01:30"
  },
  "RateLimit": {
    "MaxWait": "00:00:20",
    "MaxRequestsPerSecond": 2,
    "BurstCapacity": 5,
    "DailyBudgetShare": 0.5,
    "ConcurrentLimitPause": "00:00:30",
    "DailySoftRatio": 0.8,
    "DailySoftSpeed": 0.25,
    "DailyHardRatio": 0.95,
    "DailyHardPause": "00:15:00",
    "ReportInterval": "00:00:05"
  },
  "Kafka": {
    "Topics": {
      "account": "account-changes",
      "accountRelationship": "account-relationship-changes"
    },
    "Partitions": 6
  },
  "Postgres": {
    "Retry": {
      "MaxRetryCount": 5,
      "BaseDelay": "00:00:00.100",
      "MaxRetryDelay": "00:00:05"
    }
  },
  "Aspire": {
    "Confluent": {
      "Kafka": {
        "Consumer": {
          "Config": {
            "GroupId": "salesforce-sync",
            "AutoOffsetReset": "Earliest"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  }
}