{
  "ConnectionStrings": {
    "inboxdb": "Host=localhost;Database=inboxdb;Username=postgres;Password=postgres",
    "kafka": ""
  },
  "Salesforce": {
    "InstanceUrl": "https://your-domain.my.salesforce.com",
    "BaseApiPath": "/services/data",
    "ApiVersion": "v62.0",
    "ClientId": "",
    "ClientSecret": ""
  },
  "Sync": {
    "Workers": 4,
    "BatchSize": 180,
    "MaxEntitiesPerBatch": 200
  },
  "SalesforceLimits": {
    "ConcurrentLongRunningLimit": 25,
    "LongRunningThreshold": "00:00:20",
    "RequestTimeout": "00:01:30"
  },
  "RateLimit": {
    "MaxWait": "00:00:20",
    "MaxRequestsPerSecond": 2,
    "BurstCapacity": 5,
    "ConcurrentLimitPause": "00:00:30",
    "DailySoftRatio": 0.8,
    "DailySoftSpeed": 0.25,
    "DailyHardRatio": 0.95,
    "DailyHardPause": "00:15:00"
  },
  "Kafka": {
    "Topic": "account-changes",
    "Partitions": 6
  },
  "Postgres": {
    "Retry": {
      "MaxRetryCount": 5,
      "BaseDelay": "00:00:00.100",
      "MaxRetryDelay": "00:00:05"
    }
  },
  "Aspire": {
    "Confluent": {
      "Kafka": {
        "Consumer": {
          "Config": {
            "GroupId": "salesforce-sync",
            "AutoOffsetReset": "Earliest"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  }
}