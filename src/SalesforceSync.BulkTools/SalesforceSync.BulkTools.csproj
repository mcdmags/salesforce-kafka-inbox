<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!-- Dev-only Salesforce bulk utilities (hard delete with the Bulk API); never deployed with the worker -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <RootNamespace>SalesforceSync.BulkTools</RootNamespace>
    <!-- The worker's: the same Salesforce credentials from user secrets -->
    <UserSecretsId>5f0b6f7e-3c1e-4a51-9a0e-7d2f6f1c9b31</UserSecretsId>
    <!-- The SalesforceSync reference brings its appsettings.json too; publish keeps this project's own instead of failing (NETSDK1152) -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- The worker's Salesforce client and settings, and its record classes (the objects to list) -->
    <ProjectReference Include="..\SalesforceSync\SalesforceSync.csproj" />
  </ItemGroup>

</Project>
