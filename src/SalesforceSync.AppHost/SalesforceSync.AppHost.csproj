<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="13.6.1" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>0c6d2b9a-6a3f-4f0e-9e2b-3d1a6c7b8e41</UserSecretsId>
    <!-- Nothing here uses a feature of the Aspire CLI bundle, which isn't installed -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.6.1" />
    <PackageReference Include="Aspire.Hosting.Kafka" Version="13.6.1" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.6.1" />
    <!-- Aspire.Hosting brings 2.5.302, which has a known vulnerability (NU1902); the newest 2.5 patch release is a drop-in -->
    <PackageReference Include="MessagePack" Version="2.5.307" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SalesforceSync\SalesforceSync.csproj" />
    <ProjectReference Include="..\SalesforceSync.FakeSalesforce.Server\SalesforceSync.FakeSalesforce.Server.csproj" />
    <ProjectReference Include="..\SalesforceSync.LoadGenerator\SalesforceSync.LoadGenerator.csproj" />
    <ProjectReference Include="..\..\benchmarks\SalesforceSync.Benchmarks\SalesforceSync.Benchmarks.csproj" />
  </ItemGroup>

</Project>
