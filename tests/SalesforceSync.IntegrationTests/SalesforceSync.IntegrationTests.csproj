<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>SalesforceSync.IntegrationTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoFixture" Version="4.18.1" />
    <PackageReference Include="Confluent.Kafka" Version="2.11.1" />
    <!-- 7.x only: FluentAssertions 8 and later need a commercial license -->
    <PackageReference Include="FluentAssertions" Version="[7.2.2]" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Npgsql" Version="9.0.3" />
    <PackageReference Include="Testcontainers.Kafka" Version="4.15.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageReference Include="Testcontainers.Redis" Version="4.15.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kestrel, to host the mock org in-process -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Worker pods run in-process with the worker's own registrations; the mock org is hosted on Kestrel -->
    <ProjectReference Include="..\..\src\SalesforceSync\SalesforceSync.csproj" />
    <ProjectReference Include="..\..\src\SalesforceSync.FakeSalesforce.Server\SalesforceSync.FakeSalesforce.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The worker's own defaults (Kafka topics and consumer group, Postgres retries, ...), loaded by every pod -->
    <None Include="..\..\src\SalesforceSync\appsettings.json" Link="worker.appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\sql\schema.sql" Link="schema.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\sql\claim-audit.sql" Link="claim-audit.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
  </ItemGroup>

</Project>
