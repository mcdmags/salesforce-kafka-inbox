<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>SalesforceSync.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoFixture" Version="4.18.1" />
    <PackageReference Include="AutoFixture.Xunit2" Version="4.18.1" />
    <!-- 7.x only: FluentAssertions 8 and later need a commercial license -->
    <PackageReference Include="FluentAssertions" Version="[7.2.2]" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SalesforceSync\SalesforceSync.csproj" />
    <ProjectReference Include="..\..\src\SalesforceSync.BulkTools\SalesforceSync.BulkTools.csproj" />
    <ProjectReference Include="..\..\src\SalesforceSync.FakeSalesforce\SalesforceSync.FakeSalesforce.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The drain benchmarks' workload, so its expected end state is checked without running the benchmarks -->
    <Compile Include="..\..\benchmarks\SalesforceSync.Benchmarks\AggregateWorkload.cs" Link="Benchmarks\AggregateWorkload.cs" />
    <Compile Include="..\..\src\SalesforceSync.LoadGenerator\AggregateTemplate.cs" Link="Benchmarks\AggregateTemplate.cs" />
    <Compile Include="..\..\src\SalesforceSync.LoadGenerator\AggregateFactory.cs" Link="LoadGenerator\AggregateFactory.cs" />
    <Compile Include="..\..\src\SalesforceSync.LoadGenerator\AggregateShape.cs" Link="LoadGenerator\AggregateShape.cs" />
    <None Include="..\..\templates\account-event.json" Link="account-event.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The worker's settings, to check what the running worker is configured with -->
    <None Include="..\..\src\SalesforceSync\appsettings.json" Link="worker.appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
    <Using Include="AutoFixture" />
    <Using Include="AutoFixture.Xunit2" />
  </ItemGroup>

</Project>
