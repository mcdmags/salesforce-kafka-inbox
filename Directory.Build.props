<Project>
  <!--
    Check XML doc comments in every project of the repo (src, tests, benchmarks).

    Without GenerateDocumentationFile the compiler doesn't analyze doc comments at all, so the
    command-line build missed what the IDE showed: CS1573 (a member documents some of its
    parameters but not all), CS1574 (a cref that doesn't resolve), CS1572, CS1734 and the like.
    With it on they are warnings, and the -warnaserror build fails on them.

    CS1591 (a public member without a doc comment) stays off: docs are optional, but the ones
    written must be complete and correct. The git-ignored .editorconfig disables it too, but CI
    and other machines don't have that file, so it is set here.

    EF migrations and other generated files (// <auto-generated />) aren't analyzed for doc
    comments. BenchmarkDotNet generates and builds its boilerplate project at run time under
    benchmarks/SalesforceSync.Benchmarks/bin/, so this file applies to it too: it builds with
    these settings like the other projects (the generated code is auto-generated, no warnings).
  -->
  <PropertyGroup>
    <!-- One target framework for every project (src, tests, benchmarks); a project doesn't set its own -->
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
